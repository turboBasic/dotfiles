#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

# Regenerate the chezmoi-managed copies of the VS Code profile settings.json files
# from live data, so the header and the trailing extension list can never drift from
# the profile they claim to describe.
# Usage:
#   execute from the root of the chezmoi directory:
#   $ ./vscode-import-profiles [--list | --self-check]

import functools
import json
import shutil
import subprocess
import sys
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path

SUPPORT_DIR = Path.home() / "Library/Application Support/Code/User"
REPO_PROFILES = Path("home/private_Library/private_Application Support/Code/User/profiles")
EXTENSIONS_YAML = Path("home/.chezmoidata/vscode-extensions.yaml")

INERT_NOTE = (
    "// NOTE: useDefaultFlags.settings is true — VS Code reads the root "
    "Code/User/settings.json for this profile; this file is not currently active."
)


@dataclass(frozen=True)
class Profile:
    location: str
    name: str
    uses_default_settings: bool


def list_profiles(support_dir: Path) -> list[Profile]:
    storage = json.loads((support_dir / "globalStorage/storage.json").read_text())
    return [
        Profile(entry["location"], entry["name"], entry.get("useDefaultFlags", {}).get("settings", False))
        for entry in storage["userDataProfiles"]
        if not entry["location"].startswith("builtin/")
    ]


@functools.cache
def list_extensions(name: str) -> tuple[str, ...]:
    if shutil.which("code") is None:
        sys.exit("error: the `code` CLI is not on PATH")
    out = subprocess.run(
        ["code", "--list-extensions", "--profile", name],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    return tuple(sorted(line for line in out.splitlines() if line))


_OWNED_HEADER = ("// Profile:", "// Profile path:", "// NOTE:")


def strip_rendered(body: str) -> str:
    """Undo a previous render(): chezmoi applies the annotated copy back over the live
    file, so a re-import would otherwise stack a second header and extension block."""
    lines = body.splitlines()
    while lines and lines[0].startswith(_OWNED_HEADER):
        lines.pop(0)
    for i in range(len(lines) - 1, -1, -1):
        if lines[i] == "/*" and any(l.startswith("❯ code --list-extensions") for l in lines[i:]):
            del lines[i:]
            break
    while lines and not lines[-1].strip():
        lines.pop()
    return "\n".join(lines) + "\n" if lines else ""


def render(
    name: str,
    profile_path: str,
    settings_body: str,
    extensions: Sequence[str],
    uses_default_settings: bool,
) -> str:
    header = [f"// Profile: {name}", f"// Profile path: {profile_path}"]
    if uses_default_settings:
        header.append(INERT_NOTE)
    body = settings_body if settings_body.endswith("\n") else settings_body + "\n"
    footer = [
        "/*",
        "",
        f"❯ code --list-extensions --profile {name} | sort | clipcopy",
        "",
        *extensions,
        "",
        "*/",
    ]
    return "\n".join(header) + "\n" + body + "\n".join(footer) + "\n"


def _self_check() -> None:
    live = render(
        "VW.ADMT",
        "~/Library/Application Support/Code/User/profiles/-46c02fca/settings.json",
        '{\n\t"editor.fontSize": 13\n}\n',
        ["editorconfig.editorconfig", "redhat.vscode-yaml"],
        False,
    )
    assert live == (
        "// Profile: VW.ADMT\n"
        "// Profile path: ~/Library/Application Support/Code/User/profiles/-46c02fca/settings.json\n"
        "{\n"
        '\t"editor.fontSize": 13\n'
        "}\n"
        "/*\n"
        "\n"
        "❯ code --list-extensions --profile VW.ADMT | sort | clipcopy\n"
        "\n"
        "editorconfig.editorconfig\n"
        "redhat.vscode-yaml\n"
        "\n"
        "*/\n"
    ), live

    inert = render(
        "Shell",
        "~/Library/Application Support/Code/User/profiles/7ba910e7/settings.json",
        '{\n  "editor.fontSize": 14\n}',
        ["editorconfig.editorconfig"],
        True,
    )
    assert inert == (
        "// Profile: Shell\n"
        "// Profile path: ~/Library/Application Support/Code/User/profiles/7ba910e7/settings.json\n"
        "// NOTE: useDefaultFlags.settings is true — VS Code reads the root "
        "Code/User/settings.json for this profile; this file is not currently active.\n"
        "{\n"
        '  "editor.fontSize": 14\n'
        "}\n"
        "/*\n"
        "\n"
        "❯ code --list-extensions --profile Shell | sort | clipcopy\n"
        "\n"
        "editorconfig.editorconfig\n"
        "\n"
        "*/\n"
    ), inert

    stripped = strip_rendered(
        "// Profile: ai-infra\n"
        "// Profile path: ~/Library/Application Support/Code/User/profiles/6ff9ea05/\n"
        "// Visual settings copied from the Default profile.\n"
        "{\n"
        '  "editor.fontSize": 15\n'
        "}\n"
        "/*\n"
        "\n"
        "❯ code --list-extensions --profile 00-common | sort | clipcopy\n"
        "\n"
        "editorconfig.editorconfig\n"
        "\n"
        "*/\n"
    )
    assert stripped == (
        "// Visual settings copied from the Default profile.\n"
        "{\n"
        '  "editor.fontSize": 15\n'
        "}\n"
    ), stripped
    plain = '{\n\t"a": 1\n}\n'
    assert strip_rendered(plain) == plain, strip_rendered(plain)

    print("self-check ok")


def import_profiles(support_dir: Path, repo_profiles: Path) -> None:
    for profile in list_profiles(support_dir):
        live = support_dir / "profiles" / profile.location / "settings.json"
        if not live.is_file():
            print(f"skipped {profile.name}: no settings.json")
            continue
        rendered = render(
            profile.name,
            f"~/Library/Application Support/Code/User/profiles/{profile.location}/settings.json",
            strip_rendered(live.read_text()),
            list_extensions(profile.name),
            profile.uses_default_settings,
        )
        target = repo_profiles / profile.location / "settings.json"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(rendered)
        inert = " (inert: reads root settings.json)" if profile.uses_default_settings else ""
        print(f"imported {profile.name}{inert}")


def write_vscode_extensions_yaml(path: Path, profiles: list[Profile]) -> None:
    lines = ["vscodeExtensions:"]
    for profile in sorted(profiles, key=lambda p: p.name):
        extensions = list_extensions(profile.name)
        lines.append(f"  {profile.name}:{'' if extensions else ' []'}")
        lines.extend(f"    - {ext}" for ext in extensions)
    path.write_text("\n".join(lines) + "\n")
    print(f"wrote {path}")


def main(argv: list[str]) -> int:
    if argv == ["--self-check"]:
        _self_check()
        return 0
    if argv == ["--list"]:
        for profile in list_profiles(SUPPORT_DIR):
            print(f"{profile.location}\t{profile.name}\t{profile.uses_default_settings}")
        return 0
    if argv:
        print("usage: vscode-import-profiles [--list | --self-check]", file=sys.stderr)
        return 2
    import_profiles(SUPPORT_DIR, REPO_PROFILES)
    write_vscode_extensions_yaml(EXTENSIONS_YAML, list_profiles(SUPPORT_DIR))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
