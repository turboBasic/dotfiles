#!/usr/bin/env zsh
# shellcheck disable=SC1071

# Update accounts data from 1Password and apply to chezmoi.
# Runs the full pipeline: export → encrypt → commit → init --apply.
#
# Usage:
#   ./op-update-accounts
#
# Auth: OP_SERVICE_ACCOUNT_TOKEN (recommended for agent-driven shells) or an
# authorized 1Password desktop-app session. chezmoi runs with the token
# stripped: it errors in its default `account` mode when the token is set.

set -euo pipefail

SCRIPT_DIR="${0:a:h}"
cd "$SCRIPT_DIR"

function main() {
    check_prerequisites
    export_accounts
    commit_if_changed
    apply_chezmoi
}

function check_prerequisites() {
    if ! op whoami &>/dev/null; then
        echo "1Password CLI is not authenticated." >&2
        echo "Export OP_SERVICE_ACCOUNT_TOKEN or sign in to the 1Password app." >&2
        return 1
    fi

    if [[ -z "${AGE_PASSPHRASE:-}" ]]; then
        read -r -s "AGE_PASSPHRASE?Enter AGE_PASSPHRASE: "
        echo
        export AGE_PASSPHRASE
    fi
}

function export_accounts() {
    echo "Exporting accounts from 1Password..."
    ./op-export-accounts
    echo "Done. Encrypted file updated: home/.secrets/accounts.json.age"
}

function commit_if_changed() {
    if git diff --quiet home/.secrets/accounts.json.age 2>/dev/null; then
        echo "No changes in accounts data."
        return
    fi

    echo "Committing updated accounts.json.age..."
    git add home/.secrets/accounts.json.age
    git commit -m "feat(secrets): update accounts data"
}

function apply_chezmoi() {
    echo "Running chezmoi init --apply..."
    env -u OP_SERVICE_ACCOUNT_TOKEN chezmoi init --apply
    echo "Done. Accounts data applied."
}


main "$@"
