#!/usr/bin/env zsh

# Upgrade Homebrew and Mise, pinning brew packages excluded below. Run daily
# by ~/Library/LaunchAgents/local.upgrade.plist.

set -euo pipefail

# docker-desktop bundles its own CLI and manages its own updates.
# sbx (docker/tap) is excluded by its bare name because that is what
# `brew outdated --cask --quiet` prints; its upgrade kills the running daemon
# and then fails.
typeset -ga excluded
excluded=(docker-desktop sbx)

typeset -ga to_pin
to_pin=()

main() {
    load_brew_env
    trap restore_pins EXIT INT TERM
    pin_excluded_packages

    log "brew update"
    brew update

    log "update zinit-managed mise"
    update_zinit_mise

    log "mise upgrade"
    mise upgrade
    mise upgrade --minimum-release-age 0 claude

    log "mise prune"
    mise prune --yes

    upgrade_formulas
    upgrade_casks

    log "brew autoremove"
    brew autoremove
    log "brew cleanup"
    brew cleanup --prune=30

    log "done"
}

log() {
    print -r -- "$(date '+%Y-%m-%dT%H:%M:%S%z') $*"
}

load_brew_env() {
    typeset brew_bin=""
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [[ -x "$candidate" ]] && { brew_bin="$candidate"; break }
    done
    if [[ -z "$brew_bin" ]]; then
        log "error: brew not found"
        exit 1
    fi
    eval "$("$brew_bin" shellenv)"
}

update_zinit_mise() {
    # zinit update runs the ices registered in the current shell, falling back to
    # those saved at clone time. A bare `source zinit.zsh` registers none, so the
    # stale saved atclone ran and skipped the Gatekeeper workaround. Load the real
    # config (-i) and flush the turbo queue so the jdx/mise ices are registered.
    zsh -ic '@zinit-scheduler burst; zinit update jdx/mise' </dev/null || true

    typeset mise_bin="$HOME/.local/share/zinit/polaris/bin/mise"
    typeset mise_zsh="$HOME/.local/share/zinit/plugins/jdx---mise/mise.zsh"
    if ! "$mise_bin" --version >/dev/null 2>&1 || [[ ! -s "$mise_zsh" ]]; then
        log "error: zinit-managed mise is not runnable after update"
    fi
}

pin_excluded_packages() {
    typeset -a already_pinned
    already_pinned=("${(@f)$(brew list --pinned 2>/dev/null)}")
    for package in "${excluded[@]}"; do
        (( ${already_pinned[(Ie)$package]} )) && continue
        if brew list --formula --versions -- "$package" >/dev/null 2>&1; then
            to_pin+=("$package")
        fi
    done

    (( ${#to_pin} )) || return 0
    log "pinning: ${to_pin[*]}"
    brew pin -- "${to_pin[@]}"
}

restore_pins() {
    (( ${#to_pin} )) && brew unpin -- "${to_pin[@]}" >/dev/null 2>&1 || true
}

upgrade_formulas() {
    log "brew upgrade --formula"
    brew upgrade --formula --yes
}

upgrade_casks() {
    # Casks ignore pinning, so they are filtered by name instead.
    typeset -a outdated_casks casks
    outdated_casks=("${(@f)$(brew outdated --cask --quiet 2>/dev/null)}")
    casks=()
    for cask in "${outdated_casks[@]}"; do
        [[ -z "$cask" ]] && continue
        if (( ${excluded[(Ie)$cask]} )); then
            log "skipping cask: $cask"
            continue
        fi
        casks+=("$cask")
    done

    if (( ${#casks} )); then
        log "brew upgrade --cask: ${casks[*]}"
        brew upgrade --cask --yes -- "${casks[@]}"
    else
        log "no casks to upgrade"
    fi
}

main "$@"
