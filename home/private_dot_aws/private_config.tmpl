# Default configuration

[default]
region = eu-central-1

# Cargonautica
{{- $CARGONAUTICA_ACCOUNT_ID := "381492075850" }}

[profile cargonautica-admin]
credential_process = /opt/homebrew/bin/aws-sso process --sso cargonautica --arn arn:aws:iam::{{ $CARGONAUTICA_ACCOUNT_ID }}:role/AdministratorAccess
region = eu-central-1

[profile cargonautica-readonly]
credential_process = /opt/homebrew/bin/aws-sso process --sso cargonautica --arn arn:aws:iam::{{ $CARGONAUTICA_ACCOUNT_ID }}:role/ReadOnlyAccess
region = eu-central-1


{{ $ACCOUNT_NAME := (list "mo" "ia" | join "") -}}
{{ $ACCOUNT_ROLE := (list "ad" "mt-" "data-platform-engineer" | join "") -}}
# {{ $ACCOUNT_NAME | upper }}

[sso-session {{ $ACCOUNT_NAME }}]
sso_start_url = https://{{ $ACCOUNT_NAME }}-dev.awsapps.com/start
sso_region = eu-central-1
sso_registration_scopes = sso:account:access

# BEGIN_AWS_SSO_CLI_moia

