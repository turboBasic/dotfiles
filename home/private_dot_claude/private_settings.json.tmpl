{
  "env": {
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash"
  },
  "model": "Sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.local/bin/claude_statusline_command"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "1password-docs@turbobasic": true,
    "aws-sso-cli-docs@turbobasic": true,
    "chezmoi-docs@turbobasic": true,
    "mise-docs@turbobasic": true,
    "uv-docs@turbobasic": true,
    "zinit-docs@turbobasic": true{{- if hasKey . "claude_work_plugin" }},
    "{{ .claude_work_plugin }}@{{ .claude_work_marketplace }}": true{{- end }}
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "turbobasic": {
      "source": {
        "source": "github",
        "repo": "turboBasic/claude-plugins"
      }
    }{{- if hasKey . "claude_work_repo" }},
    "{{ .claude_work_marketplace }}": {
      "source": {
        "source": "github",
        "repo": "{{ .claude_work_repo }}"
      }
    }{{- end }}
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim"
}
