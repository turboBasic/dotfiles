[tools]
actionlint = "latest"
"aqua:nushell/nushell" = "latest"
bun = "latest"
chezmoi = "latest"
claude = "latest"
go = "latest"
java = "temurin-21"
just = "latest"
lefthook = "latest"
node = "latest"
"npm:wrangler" = "latest"
opencode = "latest"
pipx = "latest"
prek = "latest"
python = "latest"
terraform = "latest"
usage = "latest"
uv = "latest"

[settings]
idiomatic_version_file_enable_tools = []
minimum_release_age = "0s"
{{- if eq .chezmoi.os "linux" }}
  python.github_attestations = false    # TODO: for some reason this is causing issues in Linux
{{- end }}


{{- $EMPLOYER_D_ORG := (list "d" "x" "c" | join "") }}
{{- $EMPLOYER_D_EMAIL := (list (list "and" "rii.mel" "nyk@" | join "") $EMPLOYER_D_ORG ".com" | join "") }}

[tasks.claude-{{ $EMPLOYER_D_ORG }}]
description = "Execute Claude with the {{ $EMPLOYER_D_ORG | upper }} enterprise claude.ai account"
dir = "{{"{{"}}cwd{{"}}"}}"
quiet = true
run = '''
  unset AWS_PROFILE \
    ANTHROPIC_API_KEY \
    ANTHROPIC_AUTH_TOKEN \
    CLAUDE_CODE_API_KEY_HELPER_TTL_MS \
    CLAUDE_CODE_USE_BEDROCK \
    ANTHROPIC_BASE_URL \
    ANTHROPIC_DEFAULT_FABLE_MODEL \
    ANTHROPIC_DEFAULT_OPUS_MODEL \
    ANTHROPIC_DEFAULT_SONNET_MODEL \
    ANTHROPIC_DEFAULT_HAIKU_MODEL
  if ! claude auth status 2>/dev/null | grep -qi "{{ $EMPLOYER_D_EMAIL }}"; then
    claude auth login --sso --email {{ $EMPLOYER_D_EMAIL }}
  fi
  # aws-sso AutoLogin opens the browser here if the SSO token has expired.
  aws sts get-caller-identity --profile "$AWS_MCP_PROFILE" >/dev/null || true
  claude $@ --mcp-config "$HOME/.config/claude/mcp.json"
'''

[tasks.claude-{{ $EMPLOYER_D_ORG }}.env]
AWS_MCP_PROFILE = "cargonautica-readonly"

[tasks.claude-default]
description = "Execute Claude with the default claude.ai account and MCP servers"
dir = "{{"{{"}}cwd{{"}}"}}"
quiet = true
run = '''
  unset AWS_PROFILE \
    ANTHROPIC_API_KEY \
    ANTHROPIC_AUTH_TOKEN \
    CLAUDE_CODE_API_KEY_HELPER_TTL_MS \
    CLAUDE_CODE_USE_BEDROCK \
    ANTHROPIC_BASE_URL \
    ANTHROPIC_DEFAULT_FABLE_MODEL \
    ANTHROPIC_DEFAULT_OPUS_MODEL \
    ANTHROPIC_DEFAULT_SONNET_MODEL \
    ANTHROPIC_DEFAULT_HAIKU_MODEL
  # aws-sso AutoLogin opens the browser here if the SSO token has expired.
  aws sts get-caller-identity --profile "$AWS_MCP_PROFILE" >/dev/null || true
  claude $@ --mcp-config "$HOME/.config/claude/mcp.json"
'''

[tasks.claude-default.env]
AWS_MCP_PROFILE = "cargonautica-readonly"

[tasks.claude-openrouter]
description = "Execute Claude Code using OpenRouter credits instead of a claude.ai subscription"
dir = "{{"{{"}}cwd{{"}}"}}"
quiet = true
run = '''
#!/usr/bin/env zsh
set -euo pipefail
unset AWS_PROFILE \
  CLAUDE_CODE_USE_BEDROCK \
  CLAUDE_CODE_USE_VERTEX \
  CLAUDE_CODE_USE_FOUNDRY \
  CLAUDE_CODE_OAUTH_TOKEN \
  CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR \
  CLAUDE_CODE_API_KEY_HELPER_TTL_MS \
  CLAUDE_CODE_SUBAGENT_MODEL \
  ANTHROPIC_CUSTOM_HEADERS
if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
  auth_file="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json"
  if [[ ! -r "$auth_file" ]]; then
    print -u2 "claude-openrouter: set OPENROUTER_API_KEY or log in to OpenRouter with opencode auth login"
    exit 1
  fi
  if ! OPENROUTER_API_KEY=$(jq -er \
    '.openrouter | select(.type == "api") | .key | select(type == "string" and length > 0)' "$auth_file"); then
    print -u2 "claude-openrouter: no valid OpenRouter API key in $auth_file; set OPENROUTER_API_KEY or run opencode auth login"
    exit 1
  fi
fi
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
exec claude --settings '{"apiKeyHelper":"","fastMode":false}' "$@" --mcp-config "$HOME/.config/claude/mcp.json"
'''

[tasks.claude-openrouter.env]
AWS_MCP_PROFILE = "cargonautica-readonly"
ANTHROPIC_API_KEY = ""
ANTHROPIC_BASE_URL = "https://openrouter.ai/api"
ANTHROPIC_MODEL = "sonnet"
ANTHROPIC_DEFAULT_FABLE_MODEL = "anthropic/claude-fable-5.1[1m]"
ANTHROPIC_DEFAULT_OPUS_MODEL = "anthropic/claude-opus-5.5[1m]"
ANTHROPIC_DEFAULT_SONNET_MODEL = "anthropic/claude-sonnet-5.5[1m]"
ANTHROPIC_DEFAULT_HAIKU_MODEL = "anthropic/claude-haiku-5.5[1m]"
ANTHROPIC_SMALL_FAST_MODEL = "anthropic/claude-haiku-5.5[1m]"

{{- $CUSTOMER_M_ORG := (list "mo" "ia" | join "") }}

[tasks.claude-{{ $CUSTOMER_M_ORG }}]
