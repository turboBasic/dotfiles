# aliases for Claude Code tasks
[shell_alias]
claude-default = "mise run claude-default --"
claude-{{ $EMPLOYER_D_ORG }} = "mise run claude-{{ $EMPLOYER_D_ORG }} --"
claude-openrouter = "mise run claude-openrouter --"
claude-{{ $CUSTOMER_M_ORG }} = "mise run claude-{{ $CUSTOMER_M_ORG }} --"
claude-{{ $CUSTOMER_M_ORG }}-bedrock = "mise run claude-{{ $CUSTOMER_M_ORG }}-bedrock --"
