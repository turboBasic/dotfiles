dir = "{{"{{"}}cwd{{"}}"}}"
quiet = true
run = '''
  unset AWS_PROFILE CLAUDE_CODE_USE_BEDROCK
  # aws-sso AutoLogin opens the browser here if the SSO token has expired.
  aws sts get-caller-identity --profile "$AWS_MCP_PROFILE" >/dev/null || true
  OP_SERVICE_ACCOUNT_TOKEN=$(op read "op://Personal/rbcvlawhbstklfig7ziwhju734/work-vw-service-account") claude --settings '{"apiKeyHelper":"/opt/{{ $CUSTOMER_M_ORG }}/bin/litellm-prd-helper"}' $@ --mcp-config "$HOME/.config/claude/mcp.json"
