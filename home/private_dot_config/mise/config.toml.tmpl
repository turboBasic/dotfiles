ANTHROPIC_DEFAULT_HAIKU_MODEL = "claude-haiku-4-5"

[tasks.claude-{{ $CUSTOMER_M_ORG }}-bedrock]
description = "Execute Claude Code with the AWS Bedrock backend in {{ $CUSTOMER_M_ORG }} AWS account"
dir = "{{"{{"}}cwd{{"}}"}}"
quiet = true
run = '''
  unset ANTHROPIC_BASE_URL
  OP_SERVICE_ACCOUNT_TOKEN=$(op read "op://Personal/rbcvlawhbstklfig7ziwhju734/work-vw-service-account") claude $@
'''

[tasks.claude-{{ $CUSTOMER_M_ORG }}-bedrock.env]
AWS_PROFILE = "sso-ai"
# AWS_REGION = "eu-central-1"
