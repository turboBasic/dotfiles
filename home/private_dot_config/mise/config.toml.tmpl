[tools]
actionlint = "latest"
"aqua:nushell/nushell" = "latest"
bun = "latest"
chezmoi = "latest"
claude = "latest"
go = "latest"
java = "temurin-21"
just = "latest"
lefthook = "latest"
node = "latest"
"npm:wrangler" = "latest"
opencode = "latest"
pipx = "latest"
prek = "latest"
python = "latest"
terraform = "latest"
usage = "latest"
uv = "latest"

[settings]
idiomatic_version_file_enable_tools = []
{{- if eq .chezmoi.os "linux" }}
  python.github_attestations = false    # TODO: for some reason this is causing issues in Linux
{{- end }}


{{- $EMPLOYER_D_ORG := (list "d" "x" "c" | join "") }}
{{- $EMPLOYER_D_EMAIL := (list (list "and" "rii.mel" "nyk@" | join "") $EMPLOYER_D_ORG ".com" | join "") }}

[tasks.claude-{{ $EMPLOYER_D_ORG }}]
description = "Execute Claude with the {{ $EMPLOYER_D_ORG | upper }} enterprise claude.ai account"
dir = "{{"{{"}}cwd{{"}}"}}"
quiet = true
run = '''
  unset AWS_PROFILE \
    ANTHROPIC_API_KEY \
    ANTHROPIC_AUTH_TOKEN \
    CLAUDE_CODE_API_KEY_HELPER_TTL_MS \
    CLAUDE_CODE_USE_BEDROCK \
    ANTHROPIC_BASE_URL \
    ANTHROPIC_DEFAULT_FABLE_MODEL \
    ANTHROPIC_DEFAULT_OPUS_MODEL \
    ANTHROPIC_DEFAULT_SONNET_MODEL \
    ANTHROPIC_DEFAULT_HAIKU_MODEL
  if ! claude auth status 2>/dev/null | grep -qi "{{ $EMPLOYER_D_EMAIL }}"; then
    claude auth login --sso --email {{ $EMPLOYER_D_EMAIL }}
  fi
  claude $@
'''

{{- $CUSTOMER_M_ORG := (list "mo" "ia" | join "") }}

[tasks.claude-{{ $CUSTOMER_M_ORG }}]
description = "Execute Claude Code with the {{ $CUSTOMER_M_ORG }} Anthropic proxy account"
dir = "{{"{{"}}cwd{{"}}"}}"
quiet = true
run = '''
  unset AWS_PROFILE CLAUDE_CODE_USE_BEDROCK
  OP_SERVICE_ACCOUNT_TOKEN=$(op read "op://Personal/rbcvlawhbstklfig7ziwhju734/work-vw-service-account") claude --settings '{"apiKeyHelper":"/opt/{{ $CUSTOMER_M_ORG }}/bin/litellm-prd-helper"}' $@
'''

[tasks.claude-{{ $CUSTOMER_M_ORG }}.env]
CLAUDE_CODE_API_KEY_HELPER_TTL_MS = "120000"
ENABLE_TOOL_SEARCH = "true"
ANTHROPIC_BASE_URL = "https://llm.{{ $CUSTOMER_M_ORG }}-01.k8s.prd.eu-central-1.{{ $CUSTOMER_M_ORG }}-group.io/"
ANTHROPIC_DEFAULT_FABLE_MODEL = "claude-fable-5"
ANTHROPIC_DEFAULT_OPUS_MODEL = "claude-opus-5-5[1m]"
ANTHROPIC_DEFAULT_SONNET_MODEL = "claude-sonnet-5"
ANTHROPIC_DEFAULT_HAIKU_MODEL = "claude-haiku-4-5"

[tasks.claude-{{ $CUSTOMER_M_ORG }}-bedrock]
description = "Execute Claude Code with the AWS Bedrock backend in {{ $CUSTOMER_M_ORG }} AWS account"
dir = "{{"{{"}}cwd{{"}}"}}"
quiet = true
run = '''
  unset ANTHROPIC_BASE_URL
  OP_SERVICE_ACCOUNT_TOKEN=$(op read "op://Personal/rbcvlawhbstklfig7ziwhju734/work-vw-service-account") claude $@
'''

[tasks.claude-{{ $CUSTOMER_M_ORG }}-bedrock.env]
AWS_PROFILE = "sso-ai"
# AWS_REGION = "eu-central-1"
CLAUDE_CODE_USE_BEDROCK = 1
ANTHROPIC_DEFAULT_FABLE_MODEL = "global.anthropic.claude-fable-5"
ANTHROPIC_DEFAULT_OPUS_MODEL = "eu.anthropic.claude-opus-5-5[1m]"
ANTHROPIC_DEFAULT_SONNET_MODEL = "eu.anthropic.claude-sonnet-5"
ANTHROPIC_DEFAULT_HAIKU_MODEL = "eu.anthropic.claude-haiku-4-5-20251001-v1:0"

# aliases for Claude Code tasks
[shell_alias]
claude-{{ $EMPLOYER_D_ORG }} = "mise run claude-{{ $EMPLOYER_D_ORG }} --"
claude-{{ $CUSTOMER_M_ORG }} = "mise run claude-{{ $CUSTOMER_M_ORG }} --"
claude-{{ $CUSTOMER_M_ORG }}-bedrock = "mise run claude-{{ $CUSTOMER_M_ORG }}-bedrock --"
