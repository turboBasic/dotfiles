// Profile: Default
// Profile path: ~/Library/Application Support/Code/User/settings.json
{
  // General settings
  "files.autoSave": "afterDelay",
  "files.exclude": {
    "**/.git": false,
    "**/.git disable exclusion of .git": true
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // Git settings
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  // Editor settings
  "editor.fontFamily": "FiraCode Nerd Font, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 15,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.stickyScroll.enabled": false,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  // UI settings
  "breadcrumbs.enabled": false,
  "window.commandCenter": false,
  "window.density.layout": "compact",
  "window.newWindowProfile": "Default",
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Monokai Pro",
  "workbench.iconTheme": "material-icon-theme",
  // Search settings
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
  },
  "search.followSymlinks": false,
  "search.smartCase": true,
  "search.useGlobalIgnoreFiles": true,
  // Terminal settings
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.scrollback": 5000,
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  // Shellcheck settings
  "shellcheck.disableVersionCheck": true,
  "shellcheck.useWorkspaceRootAsCwd": true,
  "shellformat.effectLanguages": [
    "shellscript",
    "bats"
  ],
  "shellformat.useEditorConfig": true,
  // Language-specific settings
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[svg]": {
    "editor.defaultFormatter": "jock.svg"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  // CSpell settings
  "cSpell.validateDirectives": true,
  // "cSpell.import": [ "~/.config/cspell/cspell.config.yaml" ],
  // Other settings
  "aws.telemetry": false,
  "claudeCode.preferredLocation": "panel",
  "redhat.telemetry.enabled": false,
  "svg.preview.mode": "svg",
  "projectManager.git.baseFolders": [
    "~/00-projects"
  ],
  // Matches both .vscode/ folders and .code-workspace files, so the multi-root
  // workspaces under personal/ and vw/ show up alongside the git repos.
  "projectManager.vscode.baseFolders": [
    "~/00-projects"
  ],
  // Markdown is fixed deliberately, never on save: files.autoSave is afterDelay, so a fix-on-save
  // would rewrite lists and emphasis while typing. `markdownlint.fixAll` is bound to shift+alt+f
  // for markdown in keybindings.json, and uses the repo's own .markdownlint-cli2.jsonc.
  "[markdown]": {
    "editor.formatOnSave": false
  },
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "security.promptForLocalFileProtocolHandling": false,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "cSpell.userWords": [
    "aamelnyk"
  ],
  "extensions.supportAgentsWindow": {
    "monokai.theme-monokai-pro-vscode": true
  },
  "chat.mcp.gallery.enabled": true,
  "chat.agentHost.byokModels.enabled": true,
  "chat.viewSessions.orientation": "stacked",
}
